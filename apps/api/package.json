{
  "name": "@poker/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prebuild": "npm run build --workspace=@poker/contracts",
    "pretypecheck": "npm run build --workspace=@poker/contracts",
    "pretest": "npm run build --workspace=@poker/contracts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node dist/main.js",
    "start:dev": "tsx watch src/main.ts",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "@nestjs/common": "11.2.6",
    "@nestjs/core": "11.2.6",
    "@nestjs/platform-express": "11.2.6",
    "@nestjs/platform-socket.io": "11.2.6",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/websockets": "11.2.6",
    "@poker/contracts": "^0.1.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "socket.io": "4.8.1",
    "swagger-ui-express": "5.0.1"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.6",
    "@types/jest": "30.0.0",
    "@types/node": "24.0.10",
    "@types/supertest": "6.0.3",
    "jest": "30.0.4",
    "socket.io-client": "^4.8.1",
    "supertest": "7.1.1",
    "ts-jest": "29.4.0",
    "tsx": "4.20.3",
    "typescript": "5.8.3"
  }
