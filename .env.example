# Node environment: development, test, or production.
NODE_ENV=development

# Local ports used by the API and Next.js development server.
API_PORT=3001
WEB_PORT=3000

# Next.js development proxy target. Docker/Caddy requests use the same origin instead.
API_INTERNAL_ORIGIN=http://127.0.0.1:3001

# Optional explicit Socket.IO API origin. Leave unset locally to reuse the browser host on port 3001.
# NEXT_PUBLIC_API_ORIGIN=http://localhost:3001

# Browser origin allowed to call the API and Socket.IO transport.
PUBLIC_ORIGIN=http://localhost:3000

# error, warn, log, debug, or verbose.
LOG_LEVEL=log

# Name of the opaque, HttpOnly guest-session cookie.
SESSION_COOKIE_NAME=poker_session

# Compose only. Use :80 for local HTTP. Set a real domain in production so Caddy obtains TLS.
CADDY_DOMAIN=:80
