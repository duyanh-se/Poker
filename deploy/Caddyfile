{$CADDY_DOMAIN::80} {
  header {
    -Server
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
    X-Frame-Options "DENY"
  }

  handle /health {
    reverse_proxy api:3001
  }

  handle /docs* {
    reverse_proxy api:3001
  }

  handle /socket.io/* {
    reverse_proxy api:3001
  }

  handle /api/* {
    reverse_proxy api:3001
  }

  handle {
    reverse_proxy web:3000
  }
}
